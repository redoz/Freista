<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>
      Microsoft.Testing.Platform test framework for PUnit: PUnit's own ITestFramework that
      discovers, runs, and reports each scenario step as a first-class MTP test node, plus a
      public bootstrap (RunAsync) for the generated entry point and the escape-hatch API.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PUnit\PUnit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PUnit.Mtp.Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform" />
  </ItemGroup>

  <!--
    Packaging: `dotnet add package PUnit.Mtp` should bring the generator along. We reference the
    generator only to order its build (its assembly is not referenced and never becomes a package
    dependency), then drop its dll into the package's analyzers path. The PUnit core reference
    becomes an ordinary package dependency. Add a higher Roslyn variant later by recompiling the
    generator's sources against it (see Directory.Build.props) and packing it under its own folder.
    Mirrors src/PUnit.Xunit/PUnit.Xunit.csproj.
  -->
  <ItemGroup>
    <ProjectReference Include="..\PUnit.Generator\PUnit.Generator.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_IncludePUnitGenerator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_IncludePUnitGenerator">
    <!-- Pin the analyzer TFM so this net10.0 project's TargetFramework doesn't flow to the
         netstandard2.0 generator via the MSBuild task's inherited global properties. -->
    <MSBuild Projects="..\PUnit.Generator\PUnit.Generator.csproj" Targets="GetTargetPath"
             Properties="TargetFramework=netstandard2.0;Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_PUnitGeneratorPath" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_PUnitGeneratorPath)"
                              PackagePath="analyzers/dotnet/roslyn$(PUnitRoslynVersion)/cs" />
    </ItemGroup>
  </Target>

</Project>
