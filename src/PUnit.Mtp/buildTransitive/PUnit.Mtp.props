<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!--
      The PUnit source generator emits the Microsoft.Testing.Platform entry point (a Main calling
      PUnit.Mtp's RunAsync). Default it on; a consumer sets <PUnitGenerateProgram>false</PUnitGenerateProgram>
      to supply their own Program.cs and call the public bootstrap directly.
    -->
    <PUnitGenerateProgram Condition="'$(PUnitGenerateProgram)' == ''">true</PUnitGenerateProgram>
  </PropertyGroup>

  <!-- Surface the property to the source generator (read as build_property.PUnitGenerateProgram). -->
  <ItemGroup>
    <CompilerVisibleProperty Include="PUnitGenerateProgram" />
  </ItemGroup>

</Project>
