<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!--
      The Freista source generator emits the Microsoft.Testing.Platform entry point (a Main calling
      Freista.Mtp's RunAsync). Default it on; a consumer sets <FreistaGenerateProgram>false</FreistaGenerateProgram>
      to supply their own Program.cs and call the public bootstrap directly.
    -->
    <FreistaGenerateProgram Condition="'$(FreistaGenerateProgram)' == ''">true</FreistaGenerateProgram>
  </PropertyGroup>

  <!-- Surface the property to the source generator (read as build_property.FreistaGenerateProgram). -->
  <ItemGroup>
    <CompilerVisibleProperty Include="FreistaGenerateProgram" />
  </ItemGroup>

</Project>
