<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>   <!-- required for Roslyn analyzers/generators -->
    <Description>
      Roslyn source generator + analyzer. Lowers [Scenario] methods into a PUnit scenario
      manifest and executor, and reports diagnostics when a scenario uses syntax outside the
      supported subset.
    </Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Shipped as an analyzer inside the PUnit.Mtp package, not as its own package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version comes from $(PUnitRoslynVersion) via Directory.Packages.props. PrivateAssets
         keeps the Roslyn dependency from flowing to consumers of the generator. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <!-- Analyzer release tracking (RS2008) for the shipped PUNIT diagnostics. -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
