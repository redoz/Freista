<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit-based tests for the PUnit.Xunit adapter; this project is not an MTP/PUnit.Mtp app, so
         opt out of the generator's auto-emitted Program.cs (it targets PUnit.Mtp's bootstrap). -->
    <PUnitGenerateProgram>false</PUnitGenerateProgram>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="PUnitGenerateProgram" />
  </ItemGroup>

  <!-- Acceptance tests: discovery and per-step execution messages through the real
       xUnit v3 pipeline (one scenario test case, one visible test per step, pass/fail/
       skip/timeout/cancel reporting). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PUnit.Xunit\PUnit.Xunit.csproj" />
    <!-- Run the generator over this project's scenarios, as a real consumer would. -->
    <ProjectReference Include="..\..\src\PUnit.Generator\PUnit.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
