<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- This is an xUnit project that TESTS Freista.Mtp; it uses the Test SDK's own entry point, so
         opt out of the generator's auto-emitted Program.cs (would clash with that Main). -->
    <FreistaGenerateProgram>false</FreistaGenerateProgram>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="FreistaGenerateProgram" />
  </ItemGroup>

  <!-- Behavioral tests for Freista's MTP test framework: discovery emits one node per step,
       the IStepObserver reporter maps each StepStatus onto MTP node states, and the run loop
       runs each scenario once while lighting up every executed sibling. Uses the same runner
       setup as the other Freista test projects. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Freista.Mtp\Freista.Mtp.csproj" />
    <!-- Run the generator over this project's scenarios, as a real consumer would. -->
    <ProjectReference Include="..\..\src\Freista.Generator\Freista.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
