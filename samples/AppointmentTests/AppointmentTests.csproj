<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- This project IS a Microsoft.Testing.Platform test app whose entry point is generated by
         Freista (the MTP Main forwarding to Freista.Mtp.FreistaTestApplication.RunAsync). The repo
         global.json selects the MTP runner for `dotnet test`. -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Freista normally emits the single Main; suppress the SDK-provided entry points so there is no
         clash. (These live in Freista.Mtp's buildTransitive props/targets for package consumers; the
         sample references Freista.Mtp by project, so we set them here directly.) -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <!-- This showcase hand-writes Program.cs (below) so it can opt into Freista's deterministic
         simulated-time scheduler (simulateTime: true) — the authored step durations give the HTML
         report a realistic, overlapping timeline. Suppress the generated entry point to avoid a
         second Main. A real consumer leaves this at its default (true) and gets the generated one. -->
    <FreistaGenerateProgram>false</FreistaGenerateProgram>
  </PropertyGroup>

  <!-- Expose the entry-point gate to the generator (default true ⇒ emit FreistaProgram.g.cs). -->
  <ItemGroup>
    <CompilerVisibleProperty Include="FreistaGenerateProgram" />
  </ItemGroup>

  <!-- The canonical end-to-end sample: authoring scenarios with the Given/When/Then DSL, run by
       Freista's own Microsoft.Testing.Platform test framework with each business step reported as its
       own MTP test node. A real consumer would `dotnet add package Freista.Mtp` (which bundles the
       generator and the entry-point props/targets) plus `xunit.v3.assert`; here we reference the
       runtime adapter and wire the generator in as an analyzer, and bring assertions only. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3.assert" />
    <!-- Only for the [LoggerMessage] source generator the lifecycle DSL uses; ILogger itself arrives
         transitively through Freista. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Freista.Mtp\Freista.Mtp.csproj" />
    <ProjectReference Include="..\..\src\Freista.Generator\Freista.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
