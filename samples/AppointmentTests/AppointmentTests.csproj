<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- This project IS a Microsoft.Testing.Platform test app whose entry point is generated by
         PUnit (the MTP Main forwarding to PUnit.Mtp.PUnitTestApplication.RunAsync). The repo
         global.json selects the MTP runner for `dotnet test`. -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- PUnit emits the single Main; suppress the SDK-provided entry points so there is no clash.
         (These live in PUnit.Mtp's buildTransitive props/targets for package consumers; the sample
         references PUnit.Mtp by project, so we set them here directly.) -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <!-- Expose the entry-point gate to the generator (default true ⇒ emit PUnitProgram.g.cs). -->
  <ItemGroup>
    <CompilerVisibleProperty Include="PUnitGenerateProgram" />
  </ItemGroup>

  <!-- The canonical end-to-end sample: authoring scenarios with the Given/When/Then DSL, run by
       PUnit's own Microsoft.Testing.Platform test framework with each business step reported as its
       own MTP test node. A real consumer would `dotnet add package PUnit.Mtp` (which bundles the
       generator and the entry-point props/targets) plus `xunit.v3.assert`; here we reference the
       runtime adapter and wire the generator in as an analyzer, and bring assertions only. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PUnit.Mtp\PUnit.Mtp.csproj" />
    <ProjectReference Include="..\..\src\PUnit.Generator\PUnit.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
