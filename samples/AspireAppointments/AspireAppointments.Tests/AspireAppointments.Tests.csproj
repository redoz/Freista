<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <!-- The point of this sample: the entry point is REAL CODE you can read and breakpoint, not a
         generated file. Program.cs builds the AppHost, declares what to wait for, and registers the
         suite's own services. -->
    <FreistaGenerateProgram>false</FreistaGenerateProgram>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="FreistaGenerateProgram" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Freista.Aspire\Freista.Aspire.csproj" />
    <ProjectReference Include="..\..\..\src\Freista.Generator\Freista.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Gives DistributedApplicationTestingBuilder the generated Projects.* type for the AppHost. -->
    <ProjectReference Include="..\AspireAppointments.AppHost\AspireAppointments.AppHost.csproj"
                      IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
